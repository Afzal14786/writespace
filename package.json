{
  "name": "writespace-backend",
  "version": "1.0.0",
  "author": "Md Afzal",
  "private": true,
  "description": "WriteSpace is a social-media-based blogging platform designed primarily for technical users to create, publish, and share their thoughts, knowledge, and technical content with other users",
  "license": "MIT",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon",
    "build": "tsc && tsc-alias",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "sh scripts/seed.sh",
    "studio": "drizzle-kit studio",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "type": "commonjs",
  "overrides": {
    "esbuild": "^0.25.12",
    "fflate": "0.7.5",
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.4",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "sanitize-html": "^2.17.0",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "slugify": "^1.6.9",
    "zario": "^0.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "globals": "^17.14.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "allowScripts": {
    "esbuild": true,
    "msgpackr-extract": true
  }
}
