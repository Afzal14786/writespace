# ============================================
# WriteSpace Environment Configuration
# ============================================

# Server Configuration
# --------------------------------------------
PORT=5000
NODE_ENV=development  # development, production, test

# Database Configuration
# --------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/writespace
# Format: postgresql://[username]:[password]@[host]:[port]/[database]

# Redis Configuration
# --------------------------------------------
REDIS_URL=redis://localhost:6379
# For Redis with password: redis://:password@host:6379
# For Redis Cluster: redis://host1:6379,host2:6379

# JWT Authentication
# --------------------------------------------
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your-access-secret-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters

# Token expiration times
JWT_ACCESS_EXPIRE=15m           # 15 minutes (use: 15m, 1h, 7d)
JWT_REFRESH_EXPIRE=7d           # 7 days

# OAuth2 Configuration (Optional)
# --------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# AWS S3 Configuration (for file uploads)
# --------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=writespace-uploads
AWS_S3_BUCKET_URL=https://your-bucket.s3.amazonaws.com

# Optional: AWS CloudFront CDN URL
# AWS_CLOUDFRONT_URL=https://your-cloudfront.cloudfront.net

# Email Configuration (Nodemailer)
# --------------------------------------------
# SMTP Settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_SECURE=false  # true for port 465, false for 587

# For other providers (SendGrid, Mailgun, etc.)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-key

# Email Sender Details
EMAIL_FROM=noreply@writespace.com
EMAIL_FROM_NAME=WriteSpace

# Client Application
# --------------------------------------------
# URL of the frontend application (for CORS and redirects)
CLIENT_URL=http://localhost:3000
# For production: https://yourdomain.com

# Rate Limiting
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes (in milliseconds)
RATE_LIMIT_MAX_REQUESTS=100      # Maximum requests per window

# Logging
# --------------------------------------------
LOG_LEVEL=debug                  # debug, info, warn, error
# In production, use 'info' or 'warn'

# File Upload Limits
# --------------------------------------------
MAX_FILE_SIZE_MB=5               # Maximum file size in MB
MAX_FILES_PER_UPLOAD=10          # Maximum number of files per upload

# Queue Configuration (BullMQ)
# --------------------------------------------
# Redis connection already handled by REDIS_URL
QUEUE_ATTEMPTS=3                 # Number of retry attempts for failed jobs
QUEUE_BACKOFF_DELAY=5000         # Delay between retries in milliseconds

# CORS Configuration
# --------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Session Configuration (if using sessions)
# --------------------------------------------
SESSION_SECRET=your-session-secret-minimum-32-characters

# Security
# --------------------------------------------
# Rate limiting for auth endpoints (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5   # Only 5 login attempts per 15 minutes

# Password Reset
# --------------------------------------------
PASSWORD_RESET_TOKEN_EXPIRY=3600000  # 1 hour in milliseconds
PASSWORD_RESET_CODE_LENGTH=6         # Length of numeric reset code

# Feature Flags (Enable/disable features)
# --------------------------------------------
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_POST_SCHEDULING=true
ENABLE_USER_SHARE=true

# Development Only
# --------------------------------------------
# Automatically run migrations on startup (development only)
AUTO_MIGRATE=false

# Seed database with test data on startup (development only)
SEED_DATABASE=false

# Performance Monitoring
# --------------------------------------------
# New Relic APM (optional)
# NEW_RELIC_LICENSE_KEY=your-key
# NEW_RELIC_APP_NAME=writespace-api

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=development

# ============================================
# Important Notes:
# 1. Never commit .env files to version control
# 2. Keep secrets secure and rotate periodically
# 3. Use different values for each environment
# 4. Generate strong secrets using: openssl rand -base64 32
# ============================================