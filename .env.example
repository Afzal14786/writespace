# APPLICATION

PORT=8000
NODE_ENV=development

CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000/api/v1

SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=0


# POSTGRESQL

DATABASE_URL=postgresql://postgres:password@localhost:5432/writespace

DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000


# REDIS

REDIS_URL=redis://localhost:6379

# Optional Redis password
# REDIS_PASSWORD=redis_password

REDIS_CONNECT_TIMEOUT_MS=10000


# BULLMQ / BACKGROUND WORKERS

# Worker concurrency
EMAIL_WORKER_CONCURRENCY=5
MEDIA_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_CONCURRENCY=10

# Queue retry attempts
EMAIL_QUEUE_ATTEMPTS=3
MEDIA_QUEUE_ATTEMPTS=3
NOTIFICATION_QUEUE_ATTEMPTS=2

# Shared retry backoff delay
QUEUE_BACKOFF_DELAY_MS=1000


# RATE LIMITING

# General API: IP-based
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=300

# Login: IP-based
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=10

# Login: email-based
LOGIN_EMAIL_RATE_LIMIT_WINDOW_MS=900000
LOGIN_EMAIL_RATE_LIMIT_MAX_REQUESTS=5

# Registration: IP-based
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX_REQUESTS=10

# Registration: email-based
REGISTER_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_EMAIL_RATE_LIMIT_MAX_REQUESTS=3

# Email verification: IP-based
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
EMAIL_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=10

# Email verification: email-based
EMAIL_VERIFICATION_EMAIL_RATE_LIMIT_WINDOW_MS=600000
EMAIL_VERIFICATION_EMAIL_RATE_LIMIT_MAX_REQUESTS=5

# Forgot password: IP-based
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX_REQUESTS=5

# Forgot password: email-based
FORGOT_PASSWORD_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_EMAIL_RATE_LIMIT_MAX_REQUESTS=3

# Reset password: IP-based
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
RESET_PASSWORD_RATE_LIMIT_MAX_REQUESTS=10


# AUTHENTICATION

JWT_ACCESS_SECRET=jwt_access_secret
JWT_REFRESH_SECRET=jwt_refresh_secret

JWT_ACCESS_EXPIRE=15m


# CLOUDINARY

CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# UPLOAD LIMITS

MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=12


# SMTP / EMAIL

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USER=username@gmail.com
SMTP_PASS=password_app_google


# OAUTH

# Google OAuth
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=github_client_id
GITHUB_CLIENT_SECRET=github_client_secret


# AI CONFIGURATION

# Global AI switch
AI_ENABLED=false

# Available providers: gemini, mock
AI_PROVIDER=gemini 

# Gemini API key
GEMINI_API_KEY=ai_key

# Gemini model
AI_MODEL=ai_model

# AI request configuration
AI_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_RETRIES=2
