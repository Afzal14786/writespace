# Application
NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000/api/v1
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/writespace
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Redis
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=10000

# Background workers
EMAIL_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_CONCURRENCY=10
MEDIA_WORKER_CONCURRENCY=5

EMAIL_QUEUE_ATTEMPTS=3
NOTIFICATION_QUEUE_ATTEMPTS=2
MEDIA_QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=1000

# Authentication
JWT_ACCESS_SECRET=replace_with_a_secure_secret
JWT_REFRESH_SECRET=replace_with_a_secure_secret
JWT_ACCESS_EXPIRE=15m

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=12

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI configuration (unchanged)
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=your_gemini_model
AI_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_RETRIES=2
