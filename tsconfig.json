{
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "target": "es2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    
    "strict": true,
    "strictPropertyInitialization": false,
        
    "paths": {
      "@modules/*": ["./src/modules/*"],
      "@config/*": ["./src/config/*"],
      "@shared/*": ["./src/shared/*"],
      "@db/*": ["./src/db/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/shared/types"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}